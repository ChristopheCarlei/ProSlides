# Règles de cache Netlify (fichier ignoré par les autres hébergeurs).
#
# Principe : les ressources qui ne changent jamais sont mises en cache
# longtemps ; les pages HTML restent revalidées à chaque visite, pour
# qu'une correction de diapo soit visible immédiatement.

# Polices — jamais modifiées depuis la création du dépôt.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Moteur reveal.js — version figée.
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Logos institutionnels — très stables.
/assets/logos/*
  Cache-Control: public, max-age=2592000

# Vidéos et images de fond — gros fichiers, mais un clip peut être
# remplacé sous le même nom entre deux séances : 1 jour de cache, puis
# réutilisation immédiate pendant la revalidation en arrière-plan.
/assets/clips/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Feuilles de style et scripts partagés par les 13 séances.
#
# Ils n'avaient aucune règle et retombaient sur le défaut de Netlify — qui se
# trouve être identique, mais rien ne le garantit. La règle est donc explicite.
# Même politique que les pages : revalidation à chaque visite, pour qu'une
# correction d'habillage apparaisse immédiatement après un push. Le coût est
# d'une requête conditionnelle par fichier, qui répond 304 sans corps.
/assets/deck.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/support.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/support.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/elearn.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/elearn.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/mobile.js
  Cache-Control: public, max-age=0, must-revalidate

# Composant partagé.
/image-slot.js
  Cache-Control: public, max-age=86400

# Icône.
/favicon.svg
  Cache-Control: public, max-age=604800

# Les pages de séance ne sont volontairement pas mises en cache :
# toute modification d'une diapo doit apparaître au rechargement.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
